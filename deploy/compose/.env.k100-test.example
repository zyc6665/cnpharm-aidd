# Copy to .env.k100-test on the K100 test host and replace all secret values.

APP_VERSION=k100-test
ENVIRONMENT=development
DEBUG=false

# Host ports exposed by deploy/compose/docker-compose.k100-test.yml
FRONTEND_PORT=8585
BACKEND_PORT=9501
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL
POSTGRES_DB=scitool
POSTGRES_USER=scitool
POSTGRES_PASSWORD=replace-with-k100-postgres-password

# Redis
REDIS_PASSWORD=replace-with-k100-redis-password

# MinIO
MINIO_ROOT_USER=scitool-minio
MINIO_ROOT_PASSWORD=replace-with-k100-minio-password
MINIO_BUCKET=scitool-files

# Security keys must be at least 32 characters and must differ.
JWT_SECRET_KEY=replace-with-k100-jwt-secret-min-32-chars
SETTINGS_ENCRYPTION_KEY=replace-with-k100-settings-key-min-32-chars

# K100 test is usually accessed by HTTP/IP, so ENVIRONMENT defaults to development.
# If using production/staging, switch these to trusted HTTPS origins.
CORS_ORIGINS=["http://localhost:8585","http://127.0.0.1:8585","http://202.119.189.245:8585"]

# Task execution and storage
TASK_EXECUTION_BACKEND=celery
CELERY_WORKER_CONCURRENCY=2
CACHE_BACKEND=redis
STORAGE_BACKEND=minio
MAX_FILE_SIZE_MB=1024

# Enable the project/workflow surfaces during K100 platform testing.
AIDD_PROJECT_WORKSPACE_ENABLED=true
AIDD_PROJECT_CONVERSATIONS_ENABLED=true
PROJECT_RESEARCH_BOARD_ENABLED=true
TOOL_PACKAGE_V1_ENABLED=false
LEGACY_AIDD_API_ENABLED=false

# Test-only relaxation for legacy docker_image tools. ssh_job tools do not need it.
DOCKER_REQUIRE_IMAGE_DIGEST_IN_DEPLOYMENT=false

# SSH job credentials for the worker. Match the tool config password_ref/auth_ref.
# Example: password_ref "k100_model_test" maps to SSH_PASSWORD_REF_K100_MODEL_TEST.
SSH_PASSWORD_REF_K100_MODEL_TEST=replace-with-k100-ssh-password
# Keep this if reusing imported test tools that still reference ssh_4090_zhouyc.
SSH_PASSWORD_REF_SSH_4090_ZHOUYC=replace-only-if-needed
# Optional known_hosts file path inside the worker container.
# SSH_KNOWN_HOSTS=/run/secrets/k100_known_hosts

