FROM 127.0.0.1:30500/aidd/compute-boltz2:1.0.0

COPY boltz_affinity_platform.py /opt/aidd/boltz2/boltz_affinity_platform.py
RUN chmod +x /opt/aidd/boltz2/boltz_affinity_platform.py

ENV DRP_MODEL_ENTRY=/opt/aidd/boltz2/boltz_affinity_platform.py

# 兼容存量 DB entrypoint（/opt/sciminer/...）：同名符号链接
RUN ln -sfn /opt/aidd /opt/sciminer
