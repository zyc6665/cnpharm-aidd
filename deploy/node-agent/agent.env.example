# drp-node-agent 环境配置（复制为 /etc/drp/agent.env，600 权限）
# 平台 API 基址（含 /api/v1）
DRP_PLATFORM_BASE_URL=http://127.0.0.1:8000/api/v1
# Agent 上报卡位状态到平台所用的 token（必须与平台后端 DRP_NODE_AGENT_REPORT_TOKEN 一致）
DRP_AGENT_REPORT_TOKEN=change-me-report-token
# 平台调用 Agent 时携带的 Bearer token（与平台 DRP_NODE_AGENT_TOKEN 一致）；留空则不校验
DRP_AGENT_API_TOKEN=change-me-agent-token
# 卡位声明
DRP_SLOTS_FILE=/etc/drp/slots.yaml
# 工作目录 / 日志目录
DRP_WORK_ROOT=/var/drp/work
DRP_LOG_ROOT=/var/drp/logs
# 监听地址与上报周期
DRP_AGENT_HOST=0.0.0.0
DRP_AGENT_PORT=8780
DRP_REPORT_INTERVAL_SECONDS=15
