# LVPocket Service 环境变量配置
# 复制此文件为 .env 并修改配置

# ==================== 服务配置 ====================
APP_NAME=LVPocket Service
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ==================== LVpocket 源代码路径 ====================
# 指向 LVpocket 源代码目录，用于导入 model.LV_former 和 tfbio.data 模块
# LVpocket 源码已移动到 model/LVpocket 目录
LVPOCKET_SOURCE_PATH=/data/zhouyc/cpumodel_sciminer/example/lvpocket-service/model/LVpocket

# ==================== 模型配置 ====================
# 模型目录（包含所有 SCOP 分类模型）
MODEL_DIR=/data/zhouyc/cpumodel_sciminer/example/lvpocket-service/model/LVpocket/trained_model

# 模型文件路径（.h5/.hdf 格式）- 保持兼容
# 需要从 Zenodo 下载: https://doi.org/10.5281/zenodo.10633690
# 下载后放到 model/LVpocket/trained_model/ 目录
MODEL_PATH=/data/zhouyc/cpumodel_sciminer/example/lvpocket-service/model/LVpocket/trained_model/scale_0.5_1.h5
MODEL_VERSION=1.0.0

# 体素分辨率 (Å)，参考 predict.py --scale 默认值
SCALE=0.5

# 最大距离阈值，参考 predict.py --max_dist 默认值
MAX_DIST=35.0

# ==================== SCOP 结构分类配置 ====================
# 默认使用的结构分类模型
# 可选值: baseline | alpha | beta | alpha_beta | alpha_plus_beta
# - baseline: 基线模型，适用于所有蛋白质（默认）
# - alpha: α 类蛋白质，主要由 α 螺旋组成
# - beta: β 类蛋白质，主要由 β 折叠组成
# - alpha_beta: α/β 类蛋白质，α 螺旋和 β 折叠交替排列
# - alpha_plus_beta: α+β 类蛋白质，α 螺旋和 β 折叠分离排列
DEFAULT_STRUCTURE_CLASS=baseline

# ==================== 预测参数 ====================
# 默认口袋预测阈值 (0-1)
DEFAULT_THRESHOLD=0.5

# 默认最小口袋体素数
DEFAULT_MIN_SIZE=50

# ==================== 文件配置 ====================
# 最大文件大小 (bytes)，默认 50MB
MAX_FILE_SIZE=52428800

# 临时文件目录
TEMP_DIR=/tmp/lvpocket

# 输出文件目录
OUTPUT_DIR=/data/zhouyc/cpumodel_sciminer/example/lvpocket-service/output

# ==================== 超时配置 ====================
# 请求超时（秒）
REQUEST_TIMEOUT=300

# 文件下载超时（秒）
DOWNLOAD_TIMEOUT=60

# ==================== GPU 配置 ====================
# 使用的 GPU 设备 ID（参考 predict.py 中 os.environ["CUDA_VISIBLE_DEVICES"]）
CUDA_VISIBLE_DEVICES=0

# 允许 TensorFlow GPU 内存动态增长
TF_FORCE_GPU_ALLOW_GROWTH=true
