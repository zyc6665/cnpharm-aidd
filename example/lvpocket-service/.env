# LVPocket Service 环境变量配置
# 实际部署配置 - 适配 newbest/new_best 模型文件

# ==================== 服务配置 ====================
APP_NAME=LVPocket Service
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ==================== LVpocket 源代码路径 ====================
# 容器内路径（与docker-compose.yml中的挂载路径一致）
LVPOCKET_SOURCE_PATH=/app/model/LVpocket

# ==================== 模型配置 ====================
# 模型目录 - trained_model 根目录（子目录路径在 MODEL_FILES 中配置）
MODEL_DIR=/app/model/LVpocket/trained_model

# 模型文件 - 基线模型（默认，保持兼容）
MODEL_PATH=/app/model/LVpocket/trained_model/newbest/new_best/baseline_model.hdf
MODEL_VERSION=1.0.0

# 体素分辨率 (Å)
SCALE=0.5

# 最大距离阈值
MAX_DIST=35.0

# ==================== SCOP 结构分类配置 ====================
# 默认使用的结构分类模型
DEFAULT_STRUCTURE_CLASS=baseline

# ==================== 预测参数 ====================
# 默认口袋预测阈值 (0-1)
DEFAULT_THRESHOLD=0.5

# 默认最小口袋体素数
DEFAULT_MIN_SIZE=50

# ==================== 文件配置 ====================
# 最大文件大小 (bytes)，默认 50MB
MAX_FILE_SIZE=52428800

# 临时文件目录
TEMP_DIR=/tmp/lvpocket

# 输出文件目录
OUTPUT_DIR=/app/data/output

# ==================== 超时配置 ====================
# 请求超时（秒）
REQUEST_TIMEOUT=300

# 文件下载超时（秒）
DOWNLOAD_TIMEOUT=60

# ==================== GPU 配置 ====================
# 使用的 GPU 设备 ID
CUDA_VISIBLE_DEVICES=0

# 允许 TensorFlow GPU 内存动态增长
TF_FORCE_GPU_ALLOW_GROWTH=true
