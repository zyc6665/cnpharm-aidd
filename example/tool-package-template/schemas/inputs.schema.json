{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sciminer:tool-package-template:inputs:v1",
  "title": "Pocket analysis inputs",
  "type": "object",
  "required": ["protein"],
  "properties": {
    "protein": {
      "type": "object",
      "required": ["artifact_id", "semantic_type", "uri"],
      "properties": {
        "artifact_id": {"type": "string", "format": "uuid"},
        "semantic_type": {"const": "protein_structure"},
        "uri": {"type": "string", "pattern": "^artifact://"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
