{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sciminer:lvpocket:inputs:v1",
  "title": "LVpocket inputs",
  "type": "object",
  "required": ["protein"],
  "properties": {
    "protein": {
      "type": "object",
      "required": ["artifact_id", "semantic_type", "uri", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "format": "uuid"},
        "semantic_type": {"const": "protein_structure"},
        "uri": {"type": "string", "pattern": "^artifact://"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
