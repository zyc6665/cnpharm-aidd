{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sciminer:lvpocket:outputs:v1",
  "title": "LVpocket outputs",
  "type": "object",
  "required": ["pockets", "report"],
  "properties": {
    "pockets": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"artifact_type": {"const": "pocket_result"}}}
      ]
    },
    "report": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"artifact_type": {"const": "run_report"}}}
      ]
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["artifact_type", "path", "sha256"],
      "properties": {
        "artifact_type": {"type": "string"},
        "path": {"type": "string", "minLength": 1, "pattern": "^[^/]"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
