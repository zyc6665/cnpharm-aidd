{
  "name": "SSH Job Tool Template",
  "slug": "ssh-job-tool-template",
  "description": "通用 ssh_job 工具配置模板，用于复用远端已有模型容器或运行环境",
  "icon": "🛰️",
  "category": "template",
  "version": "0.1.0",
  "changelog": "Initial ssh_job template version",
  "tool_config": {
    "type": "ssh_job",
    "host": "gpu-node-01.internal",
    "port": 22,
    "username": "platform_runner",
    "auth_ref": "ssh_gpu_node_01",
    "runner_mode": "docker_exec",
    "remote_base_dir": "/srv/platform-jobs",
    "container_base_dir": "/workspace/platform-jobs",
    "entrypoint": "/app/platform_run.sh",
    "container_name": "targetdiff-prod",
    "timeout_sec": 3600,
    "cleanup_remote": true,
    "strict_host_key_checking": true,
    "env": {
      "CUDA_VISIBLE_DEVICES": "0"
    },
    "output_globs": [
      "output/result.json",
      "output/logs/run.log",
      "output/artifacts/**/*"
    ],
    "example_params": {
      "task_name": "pocket_generation",
      "params": {
        "num_samples": 8,
        "batch_size": 4
      },
      "input_files": {
        "pocket_pdb": "input/example_pocket10.pdb"
      }
    },
    "examples": [
      {
        "name": "SSH Job 模板示例",
        "description": "使用一个最小 pocket PDB 文件演示 ssh_job 工具输入格式。",
        "params": {
          "task_name": "pocket_generation",
          "params": {
            "num_samples": 8,
            "batch_size": 4
          }
        },
        "input_files": {
          "pocket_pdb": "input/example_pocket10.pdb"
        }
      }
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "平台任务 ID",
          "hidden": true
        },
        "task_name": {
          "type": "string",
          "description": "模型侧能力名称，例如 pocket_generation",
          "hidden": true
        },
        "params": {
          "type": "object",
          "description": "业务参数集合"
        },
        "input_files": {
          "type": "object",
          "description": "业务输入文件集合，由平台上传后自动映射到任务目录",
          "properties": {
            "pocket_pdb": {
              "type": "string",
              "title": "Pocket PDB 文件",
              "format": "file",
              "accept": ".pdb",
              "description": "上传已裁剪的 pocket PDB 文件"
            }
          },
          "required": [
            "pocket_pdb"
          ]
        }
      },
      "required": [
        "task_id",
        "params",
        "input_files"
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "任务是否执行成功"
        },
        "message": {
          "type": "string",
          "description": "执行结果摘要"
        },
        "outputs": {
          "type": "object",
          "description": "模型输出摘要"
        },
        "artifacts": {
          "type": "array",
          "description": "可回传平台的结果文件描述",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "content_type": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "path"
            ]
          }
        },
        "metrics": {
          "type": "object",
          "description": "执行耗时等附加指标"
        },
        "error": {
          "type": "object",
          "description": "失败时的错误结构"
        }
      },
      "required": [
        "success",
        "message"
      ]
    }
  }
}
