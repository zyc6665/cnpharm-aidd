{
  "name": "simple-text-tool",
  "slug": "simple-text-tool",
  "display_name": "简单文本处理工具",
  "description": "一个简单的文本处理工具，支持大小写转换、文本反转和统计功能",
  "version": "1.0.0",
  "author": "SciTool Team",
  "category": "text-processing",
  "tags": ["文本处理", "测试工具", "示例"],
  "tool_config": {
    "type": "remote_api",
    "endpoint": "http://simple-text-tool:8000/process",
    "method": "POST",
    "timeout": 30,
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "title": "输入文本",
        "description": "需要处理的文本内容",
        "minLength": 1,
        "maxLength": 10000
      },
      "operation": {
        "type": "string",
        "title": "处理操作",
        "description": "选择要执行的文本处理操作",
        "enum": ["uppercase", "lowercase", "reverse", "stats"],
        "enumNames": ["转大写", "转小写", "反转文本", "仅统计"],
        "default": "uppercase"
      },
      "add_stats": {
        "type": "boolean",
        "title": "添加统计信息",
        "description": "是否在结果中包含字符数、单词数等统计信息",
        "default": true
      }
    },
    "required": ["text", "operation"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "processed_text": {
        "type": "string",
        "description": "处理后的文本"
      },
      "operation": {
        "type": "string",
        "description": "执行的操作"
      },
      "statistics": {
        "type": "object",
        "description": "文本统计信息",
        "properties": {
          "char_count": {
            "type": "integer",
            "description": "字符数"
          },
          "word_count": {
            "type": "integer",
            "description": "单词数"
          },
          "line_count": {
            "type": "integer",
            "description": "行数"
          }
        }
      }
    }
  }
}
