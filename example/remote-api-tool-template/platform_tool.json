{
  "name": "Remote API Tool Template",
  "slug": "remote-api-tool-template",
  "description": "通用 remote_api 工具模板，可作为新服务导入平台的起点。",
  "icon": "R",
  "category": "template",
  "version": "0.1.0",
  "changelog": "Initial remote_api template version",
  "tool_config": {
    "type": "remote_api",
    "endpoint": "http://remote-api-tool-template:8000/predict",
    "method": "POST",
    "timeout_sec": 600,
    "input_schema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "平台任务 ID",
          "hidden": true
        },
        "params": {
          "type": "object",
          "description": "业务参数集合"
        }
      },
      "required": [
        "task_id",
        "params"
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "task_id": {
          "type": "string"
        },
        "outputs": {
          "type": "object"
        }
      },
      "required": [
        "success",
        "task_id"
      ]
    }
  }
}
