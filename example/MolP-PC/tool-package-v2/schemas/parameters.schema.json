{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sciminer:molp-pc-property-prediction:parameters:v2",
  "title": "MolP-PC property prediction parameters",
  "type": "object",
  "properties": {
    "task_groups": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Absorption",
          "Distribution",
          "Excretion",
          "Metabolism",
          "Toxicology",
          "Tox21",
          "Ecotoxicity",
          "LD50"
        ]
      },
      "default": [
        "Absorption",
        "Distribution",
        "Excretion",
        "Metabolism",
        "Toxicology",
        "Tox21",
        "Ecotoxicity",
        "LD50"
      ],
      "description": "Requested ADMET task groups. Current legacy runtime emits all configured groups."
    }
  },
  "additionalProperties": false
}
