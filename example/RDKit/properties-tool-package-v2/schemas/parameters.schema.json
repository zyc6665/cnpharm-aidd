      "minLength": 1,
      "default": "SMILES"
    },
    "molecule_id_field": {
      "type": "string",
      "minLength": 1,
      "default": "molecule_id"
    },
    "device": {
      "type": "string",
      "enum": [
        "cpu"
      ],
      "default": "cpu"
    }
  },
  "additionalProperties": false
}
