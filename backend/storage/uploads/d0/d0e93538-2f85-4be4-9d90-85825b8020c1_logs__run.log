import sys
import numpy as np
from pathlib import Path

model_root = Path(sys.argv[1])
horiz_path = Path(sys.argv[2])
selected_path = Path(sys.argv[3])
sys.path.insert(0, str(model_root / "SCOP_Classifier"))

from SSP import horizRead
from predict import computeFeature, predictA

ss = horizRead(str(horiz_path))
features = np.array([computeFeature(ss["SSseq"][0])])
pred = int(predictA(features)[0])
mapping = {0: "all_a.hdf", 1: "all_b.hdf", 2: "a_or_.hdf", 3: "a+b.hdf"}
model_name = mapping.get(pred, "all_scpdb.hdf")
selected_path.write_text(model_name + "\n", encoding="utf-8")
print("{}\t{}".format(pred, model_name))
