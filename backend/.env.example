# 科学计算工具管理平台 - 环境配置文件
# 复制此文件为 .env 并根据环境修改

# ==================== 环境选择 ====================
# development: 开发环境（SQLite + 本地存储 + 内存缓存）
# staging: 预发布环境
# production: 生产环境（PostgreSQL + MinIO + Redis + Celery）
ENVIRONMENT=development
DEBUG=true

# ==================== 数据库配置 ====================
# 开发环境（SQLite）
DATABASE_URL=sqlite+aiosqlite:///./storage/scitool.db

# 生产环境（PostgreSQL）- 取消注释并配置
# DATABASE_URL=postgresql+asyncpg://scitool:password@localhost:5432/scitool_platform
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=3600

# ==================== JWT 安全配置 ====================
# 生产环境务必修改此密钥！
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 存储配置 ====================
# 存储后端: local | minio
STORAGE_BACKEND=local

# 本地存储路径（开发环境）
STORAGE_PATH=./storage/uploads

# MinIO 配置（生产环境）- 取消注释并配置
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=minio.example.com:9000
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_BUCKET=scitool-files
# MINIO_SECURE=true

# 文件大小限制（MB）
MAX_FILE_SIZE_MB=100

# ==================== 缓存配置 ====================
# 缓存后端: memory | redis
CACHE_BACKEND=memory

# Redis 配置（生产环境）- 取消注释并配置
# CACHE_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0

# ==================== Celery 任务队列配置 ====================
# 为空时使用同步执行（开发模式）
# 生产环境配置 Redis 作为消息代理
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ==================== CORS 配置 ====================
# 生产环境应限制为具体域名
CORS_ORIGINS=["*"]

# ==================== 游客配置 ====================
GUEST_DAILY_TASK_LIMIT=5
GUEST_MAX_FILE_SIZE_MB=10
GUEST_SESSION_HOURS=24

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
