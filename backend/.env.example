# 科学计算工具管理平台 - 环境配置文件
# 复制此文件为 .env 并根据环境修改

# ==================== 环境选择 ====================
# development: 开发环境（SQLite + 本地存储 + 内存缓存）
# staging: 预发布环境
# production: 生产环境（PostgreSQL + MinIO + Redis + Celery）
ENVIRONMENT=development
DEBUG=true

# ==================== 数据库配置 ====================
# 开发环境（SQLite）
DATABASE_URL=sqlite+aiosqlite:///./storage/scitool.db

# 远程模型服务下载平台输入文件时访问的后端公开地址
PUBLIC_API_BASE_URL=http://localhost:8000

# 生产环境（PostgreSQL）- 取消注释并配置
# DATABASE_URL=postgresql+asyncpg://scitool:password@localhost:5432/scitool_platform
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=3600

# ==================== JWT 安全配置 ====================
# 开发环境未配置 JWT_SECRET_KEY 时，启动会自动生成临时密钥并打印告警；
# 预发布/生产环境必须显式配置长度不少于 32 的强密钥，且不得使用示例占位符，否则拒绝启动。
JWT_SECRET_KEY=
# 开发环境 SETTINGS_ENCRYPTION_KEY 缺失时，加密操作会回退到 JWT_SECRET_KEY；
# 预发布/生产环境必须设置独立、长度不少于 32 的配置加密密钥，且不能与 JWT_SECRET_KEY 相同。
# SETTINGS_ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 存储配置 ====================
# 存储后端: local | minio
STORAGE_BACKEND=local

# 本地存储路径（开发环境）
STORAGE_PATH=./storage/uploads

# MinIO 配置（生产环境）- 取消注释并配置
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=minio.example.com:9000
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_BUCKET=scitool-files
# MINIO_SECURE=true

# 文件大小限制（MB）
MAX_FILE_SIZE_MB=100

# 管理员镜像导入
IMAGE_REGISTRY_ENDPOINT=http://localhost:5000
# IMAGE_REGISTRY_USERNAME=registry-user
# IMAGE_REGISTRY_PASSWORD=registry-password
IMAGE_REGISTRY_TIMEOUT_SECONDS=120
IMAGE_IMPORT_MAX_SIZE_MB=4096
IMAGE_IMPORT_ALLOWED_REPOSITORY_PREFIX=sciminer

# ==================== Redis 缓存配置 ====================
# 缓存后端: memory | redis
CACHE_BACKEND=memory

# Redis 配置（容器环境）- 取消注释并配置
# CACHE_BACKEND=redis
# REDIS_HOST=redis                    # 容器内使用服务名
# REDIS_PORT=6379                     # 容器内部端口
# REDIS_DB=0
# REDIS_PASSWORD=scitool123

# 本地开发环境（非容器）
# REDIS_HOST=localhost
# REDIS_PORT=9500                     # 外部映射端口

# 全局 API 限流。生产多实例必须使用 Redis，并仅在受信任反向代理后启用转发头。
REQUEST_RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_TRUST_PROXY_HEADERS=false

# ==================== Celery 任务队列配置 ====================
# 为空时使用同步执行（开发模式）
# 生产环境/容器环境配置 Redis 作为消息代理

# 容器环境配置
# CELERY_BROKER_URL=redis://:scitool123@redis:6379/1
# CELERY_RESULT_BACKEND=redis://:scitool123@redis:6379/2
# CELERY_TIMEZONE=Asia/Shanghai
# CELERY_TASK_SOFT_TIME_LIMIT=3600
# CELERY_TASK_TIME_LIMIT=7200

# 本地开发环境（非容器）
# CELERY_BROKER_URL=redis://:scitool123@localhost:9500/1
# CELERY_RESULT_BACKEND=redis://:scitool123@localhost:9500/2

# ==================== Docker 执行器安全 ====================
# 预发布/生产默认只允许运行 digest 固定镜像，例如：
# scitool/docking@sha256:<64 位十六进制摘要>
# 可选：进一步限制为精确的镜像引用列表（JSON 数组）。
# DOCKER_ALLOWED_IMAGES=["scitool/docking@sha256:<digest>"]
# DOCKER_REQUIRE_IMAGE_DIGEST_IN_DEPLOYMENT=true
# Python 脚本执行器仅在开发环境可不配置；预发布/生产环境必须配置可信脚本摘要。
# TRUSTED_PYTHON_SCRIPT_SHA256=["<64 位脚本 SHA-256 摘要>"]

# ==================== Managed Job 执行环境 ====================
# 新模型只使用 k8s_job 或 ssh_job。K8s 凭据、Namespace 和 ServiceAccount
# 由 Worker 执行环境绑定，不写入 ToolVersion 配置。
# 镜像和 MinIO 未就绪前保持 EXECUTOR_ENABLED_K8S=false；启用前先完成集群连通性、RBAC、镜像拉取和对象存储 smoke test。
# EXECUTOR_ENABLED_K8S=false
# EXECUTOR_ENABLED_SSH=true
# RESOURCE_PROFILE_REGISTRY_JSON={"cpu-small":{"tier":"cpu-small","cpu":2,"memory_gb":4,"gpu_required":false,"timeout_minutes":30,"parallelism":1},"gpu-large":{"tier":"gpu-large","cpu":16,"memory_gb":64,"gpu_required":true,"gpu_memory_gb":24,"timeout_minutes":480,"parallelism":1}}
# K8S_ADAPTER_CLUSTER_ALIAS=platform
# K8S_ADAPTER_NAMESPACE=model-jobs
# K8S_ADAPTER_CREDENTIAL_REF=platform-k8s
# K8S_ADAPTER_SERVICE_ACCOUNT=model-runner
# K8S_ADAPTER_JOB_NAME_PREFIX=sciminer
# K8S_ADAPTER_API_SERVER=https://kubernetes.default.svc
# K8S_ADAPTER_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
# K8S_ADAPTER_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
# K8S_ADAPTER_REQUEST_TIMEOUT_SECONDS=30
# K8S_ADAPTER_OBJECT_STORAGE_ENDPOINT=http://sciminer-minio.sciminer-storage:9000
# K8S_ADAPTER_OBJECT_STORAGE_BUCKET=scitool-files
# K8S_ADAPTER_OBJECT_STORAGE_SECRET_REF=sciminer-minio-client
# K8S_ADAPTER_OBJECT_STORAGE_INPUT_PREFIX=inputs
# K8S_ADAPTER_OBJECT_STORAGE_OUTPUT_PREFIX=executions
# K8S_ADAPTER_OBJECT_STORAGE_STAGING_ROOT=/tmp/sciminer-k8s-artifacts

# ==================== 管理员镜像导入 ====================
# 管理员上传 docker save/docker save.gz 后由平台推送到内部 Distribution Registry。
# 开发单节点 Registry 默认只在集群内可访问；生产环境必须配置 TLS、认证和节点可达地址。
# IMAGE_REGISTRY_ENDPOINT=http://sciminer-registry.sciminer-storage.svc.cluster.local:5000
# IMAGE_REGISTRY_IMAGE_PREFIX=sciminer-registry.sciminer-storage.svc.cluster.local:5000
# IMAGE_REGISTRY_USERNAME=
# IMAGE_REGISTRY_PASSWORD=
# IMAGE_IMPORT_MAX_SIZE_MB=16384
# IMAGE_IMPORT_ALLOWED_REPOSITORY_PREFIX=sciminer/

# ==================== CORS 配置 ====================
# 本地开发前端地址。预发布/生产环境必须替换为受控的 HTTPS 域名，禁止使用 *。
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://localhost:8585","http://127.0.0.1:8585"]
# CORS_ORIGINS=["https://staging.sciminer.example.com"]

# AIDD 内置工具的系统服务账号（生产部署必须设置为已有管理员用户 ID）
# AIDD_SYSTEM_USER_ID=

# ==================== AIDD 功能开关 ====================
# 开发环境默认开启新项目入口；预发布/生产默认关闭新入口。
# 灰度发布时显式设置这些变量，并通过 /api/v1/system/feature-flags 审计。
# 中国医药交付线已移除 Agent 对话与审批链路，故无对应开关。
# AIDD_PROJECT_WORKSPACE_ENABLED=false
# TOOL_PACKAGE_V1_ENABLED=false
# PROJECT_RESEARCH_BOARD_ENABLED=false
# LEGACY_AIDD_API_ENABLED=false
# 内部测试灰度账号；支持 JSON 数组或逗号分隔。生产回滚时必须清空。
# AIDD_ROLLOUT_USER_EMAILS=["internal-user@example.com"]
# AIDD_ROLLOUT_USER_IDS=["00000000-0000-0000-0000-000000000000"]

# ==================== 日志配置 ====================
LOG_LEVEL=INFO

# ==================== SMTP 邮件配置 ====================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=科学计算平台
SMTP_USE_TLS=true

# ==================== 验证码配置 ====================
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_EXPIRE_MINUTES=5
VERIFICATION_CODE_RATE_LIMIT_SECONDS=60
VERIFICATION_CODE_DAILY_LIMIT=10
