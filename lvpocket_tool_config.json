{
  "name": "LVPocket蛋白质口袋预测",
  "slug": "lvpocket-predict",
  "description": "基于LV_NET深度学习模型(3D CNN + Transformer)的蛋白质配体结合位点预测工具，支持多种SCOP结构分类",
  "icon": "🧬",
  "category": "bioinformatics",
  "version": "1.0.0",
  "changelog": "初始版本 - LV_NET模型集成，支持PDB/MOL2输入，多格式输出",
  "tool_config": {
    "type": "remote_api",
    "endpoint": "http://lvpocket-service:8000/predict/json",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "timeout_sec": 300,
    "input_schema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "任务ID（可选，自动生成）"
        },
        "params": {
          "type": "object",
          "properties": {
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5,
              "description": "口袋预测阈值 (0-1)，值越高越严格"
            },
            "min_size": {
              "type": "integer",
              "minimum": 1,
              "default": 50,
              "description": "最小口袋体素数，过滤掉小于此值的口袋"
            },
            "output_formats": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["json", "mol2", "cmap", "cube"]
              },
              "default": ["json"],
              "description": "输出格式：json=结构化数据, mol2=MOL2坐标, cmap=Chimera密度图, cube=Gaussian Cube格式"
            },
            "structure_class": {
              "type": "string",
              "enum": ["baseline", "alpha", "beta", "alpha_beta", "alpha_plus_beta"],
              "default": "baseline",
              "description": "蛋白质二级结构分类：baseline=通用模型, alpha=α螺旋, beta=β折叠, alpha_beta=α/β交替, alpha_plus_beta=α+β分离"
            }
          },
          "required": ["threshold", "min_size", "output_formats"]
        },
        "input_files": {
          "type": "object",
          "properties": {
            "protein_file": {
              "type": "string",
              "format": "uri",
              "description": "蛋白质文件URL (PDB或MOL2格式)"
            }
          },
          "required": ["protein_file"]
        }
      },
      "required": ["params", "input_files"]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "预测是否成功"
        },
        "result": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "description": "任务ID"
            },
            "protein_name": {
              "type": "string",
              "description": "蛋白质名称"
            },
            "num_atoms": {
              "type": "integer",
              "description": "蛋白质原子总数"
            },
            "num_pockets": {
              "type": "integer",
              "description": "检测到的口袋数量"
            },
            "processing_time": {
              "type": "number",
              "description": "处理时间（秒）"
            },
            "structure_class": {
              "type": "string",
              "description": "使用的结构分类模型"
            },
            "model_file": {
              "type": "string",
              "description": "使用的模型文件名"
            },
            "pockets": {
              "type": "array",
              "description": "口袋列表",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "description": "口袋ID"
                  },
                  "rank": {
                    "type": "integer",
                    "description": "口袋排名（按分数降序）"
                  },
                  "score": {
                    "type": "number",
                    "description": "口袋预测分数"
                  },
                  "volume": {
                    "type": "number",
                    "description": "口袋体积（立方埃）"
                  },
                  "center": {
                    "type": "object",
                    "properties": {
                      "x": {"type": "number"},
                      "y": {"type": "number"},
                      "z": {"type": "number"}
                    },
                    "description": "口袋中心坐标"
                  },
                  "bounding_box": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "object",
                        "properties": {
                          "x": {"type": "number"},
                          "y": {"type": "number"},
                          "z": {"type": "number"}
                        }
                      },
                      "max": {
                        "type": "object",
                        "properties": {
                          "x": {"type": "number"},
                          "y": {"type": "number"},
                          "z": {"type": "number"}
                        }
                      }
                    },
                    "description": "边界框"
                  },
                  "residues": {
                    "type": "array",
                    "description": "组成口袋的残基列表",
                    "items": {
                      "type": "object",
                      "properties": {
                        "chain": {"type": "string"},
                        "resname": {"type": "string"},
                        "resid": {"type": "integer"}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "output_files": {
          "type": "array",
          "description": "生成的输出文件列表",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "文件名"
              },
              "format": {
                "type": "string",
                "description": "文件格式"
              },
              "size": {
                "type": "integer",
                "description": "文件大小（字节）"
              },
              "url": {
                "type": "string",
                "description": "文件下载URL"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "description": "错误代码"
            },
            "message": {
              "type": "string",
              "description": "错误消息"
            },
            "details": {
              "type": "object",
              "description": "错误详情"
            }
          },
          "description": "错误信息（如果失败）"
        }
      },
      "required": ["success"]
    }
  }
}
